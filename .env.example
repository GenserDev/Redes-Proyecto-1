# ---------------------------------------------------------------------------
# LLM provider selection: "gemini" (default), "groq" or "anthropic"
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Google Gemini - https://aistudio.google.com/apikey (free, no credit card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Groq - https://console.groq.com/keys (free, no credit card)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic - https://console.anthropic.com (USD 5 in free credits)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Chatbot behaviour
# ---------------------------------------------------------------------------
# Conversation turns kept in context before the oldest ones are dropped
MAX_HISTORY_MESSAGES=40

# Print every MCP JSON-RPC message to the terminal 
SHOW_MCP_LOG=false
