# ---------------------------------------------------------------------------
# LLM provider selection: "groq" (default, free tier) or "anthropic"
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq

# Groq - https://console.groq.com/keys (free, no credit card)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic - https://console.anthropic.com (USD 5 in free credits)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Chatbot behaviour
# ---------------------------------------------------------------------------
# Conversation turns kept in context before the oldest ones are dropped
MAX_HISTORY_MESSAGES=40

# Print every MCP JSON-RPC message to the terminal as it happens (true/false).
# It can also be toggled at runtime with the /log command.
SHOW_MCP_LOG=false
